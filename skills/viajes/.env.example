# Claves del asesor de viajes. Este es el EJEMPLO del paquete (va vacío).
# La copia real vive en la KB del usuario: ~/.claude/agents/_kb/viajes/.env
# (la crea `travel.py setup`). Para guardar una clave: `travel.py set-key <NOMBRE>`.
# Prioridad y paso a paso: skills/viajes/SKILL.md → Credenciales.

# 1 · Rutas reales, isócronas, lugares cercanos — https://myprojects.geoapify.com (gratis, 3.000 créditos/día)
GEOAPIFY_API_KEY=

# 2 · Vuelos y hoteles con precio en vivo (Google Flights/Hotels) — https://serpapi.com/manage-api-key (gratis, 250/mes)
SERPAPI_API_KEY=

# 3 · Google Maps Platform: Places API (New) + Routes API + Geocoding API en una sola clave restringida (exige billing)
GOOGLE_MAPS_API_KEY=

# 4 · Tours y experiencias — https://partnerresources.viator.com (afiliado, Basic Access)
VIATOR_API_KEY=

# 5 · Ratings y reseñas extra — https://www.tripadvisor.com/developers (con aprobación)
TRIPADVISOR_API_KEY=
